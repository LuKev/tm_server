load("@bazel_gazelle//:def.bzl", "gazelle")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# gazelle:prefix github.com/lukev/tm_server
gazelle(name = "gazelle")

gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go.mod",
        "-to_macro=deps.bzl%go_dependencies",
        "-prune",
    ],
    command = "update-repos",
)

py_binary(
    name = "run_az_cycles",
    srcs = ["tools/run_az_cycles.py"],
    main = "tools/run_az_cycles.py",
    legacy_create_init = 0,
    data = ["WORKSPACE", "az_requirements_lock.txt"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "az_recovery_test",
    srcs = ["tools/az_recovery_test.py", "tools/run_az_cycles.py"],
    main = "tools/az_recovery_test.py",
    imports = ["tools"],
    legacy_create_init = 0,
)

sh_binary(
    name = "run_az_scaling_curves",
    srcs = ["tools/run_az_scaling_curves.sh"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "client_playwright_test",
    srcs = ["tools/client_playwright_test.sh"],
    args = ["$(location //cmd/server:server)"],
    data = ["//cmd/server:server"],
    size = "enormous",
    timeout = "eternal",
)

sh_test(
    name = "client_build_test",
    srcs = ["tools/client_build_test.sh"],
    size = "large",
    timeout = "moderate",
)

sh_test(
    name = "client_production_ui_test",
    srcs = ["tools/client_playwright_test.sh"],
    args = ["$(location //cmd/server:server)", "production"],
    data = ["//cmd/server:server"],
    size = "enormous",
    timeout = "eternal",
)

sh_binary(
    name = "client_dependencies",
    srcs = ["tools/client_dependencies.sh"],
)

sh_binary(
    name = "tm_router_dependencies",
    srcs = ["tools/tm_router_dependencies.sh"],
)

sh_test(
    name = "az_loop_smoke_test",
    srcs = ["tools/az_loop_smoke_test.sh"],
    args = [
        "$(location :run_az_cycles)",
        "$(location //cmd/az_selfplay:az_selfplay)",
        "$(location //internal/az:az_inference)",
        "$(location //internal/az:az_learner)",
        "$(location //cmd/az_eval:az_eval)",
    ],
    data = [
        ":run_az_cycles",
        "//cmd/az_eval:az_eval",
        "//cmd/az_selfplay:az_selfplay",
        "//internal/az:az_inference",
        "//internal/az:az_learner",
    ],
    size = "large",
    timeout = "moderate",
)

sh_test(
    name = "az_scaling_curves_smoke_test",
    srcs = ["tools/az_scaling_curves_smoke_test.sh"],
    args = [
        "$(location :run_az_scaling_curves)",
        "$(location //internal/az:az_model_benchmark)",
        "$(location //cmd/az_eval:az_eval)",
        "$(location //internal/az:az_inference)",
    ],
    data = [
        ":run_az_scaling_curves",
        "//cmd/az_eval:az_eval",
        "//internal/az:az_inference",
        "//internal/az:az_model_benchmark",
    ],
    size = "large",
    timeout = "moderate",
)

py_test(
    name = "az_real_recovery_test",
    deps = ["//internal/az:python_core"],
    legacy_create_init = 0,
    srcs = ["tools/az_real_recovery_test.py"],
    main = "tools/az_real_recovery_test.py",
    args = [
        "$(location :run_az_cycles)",
        "$(location //cmd/az_selfplay:az_selfplay)",
        "$(location //internal/az:az_inference)",
        "$(location //internal/az:az_learner)",
        "$(location //cmd/az_eval:az_eval)",
    ],
    data = [
        ":run_az_cycles",
        "//cmd/az_eval:az_eval",
        "//cmd/az_selfplay:az_selfplay",
        "//internal/az:az_inference",
        "//internal/az:az_learner",
    ],
    size = "large",
    timeout = "long",
)
