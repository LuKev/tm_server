load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "az_selfplay_lib",
    srcs = ["main.go"],
    importpath = "github.com/lukev/tm_server/cmd/az_selfplay",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/az",
        "//internal/game/factions",
        "//internal/models:models",
    ],
)

go_test(
    name = "az_selfplay_test",
    srcs = ["main_test.go"],
    embed = [":az_selfplay_lib"],
    deps = [
        "//internal/game/factions",
        "//internal/models:models",
    ],
)

go_binary(
    name = "az_selfplay",
    embed = [":az_selfplay_lib"],
    visibility = ["//visibility:public"],
)
